# ScrapeCreators API key (https://app.scrapecreators.com)
# Used by the shared local/Vercel server proxy — never exposed to the browser bundle.
SCRAPECREATORS_API_KEY=

# Foreplay API key (https://app.foreplay.co/api-overview)
# Used by the shared local/Vercel server proxy — never exposed to the browser bundle.
FOREPLAY_API_KEY=

# Server-side Gemini multimodal analysis. Never prefix these values with VITE_.
# The UI drawer may alternatively provide a memory-only key for the current tab.
GEMINI_API_KEY=
GEMINI_MULTIMODAL_MODEL=gemini-3.1-pro-preview-thinking
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Google official API uses google-api-key; compatible gateways may use bearer.
# GEMINI_API_AUTH_MODE=google-api-key
# GEMINI_API_ALLOWED_HOSTS=trusted-gateway.example.com
# GEMINI_REQUEST_MAX_BYTES=18874368
# Google defaults to 1 FPS. Short-form, fast-cut ads use 2 FPS plus
# scene-aware keyframes; valid Gemini range is greater than 0 through 24.
GEMINI_VIDEO_FPS=2
# Text-heavy ad videos benefit from Gemini 3 high media resolution.
GEMINI_MEDIA_RESOLUTION=MEDIA_RESOLUTION_HIGH

# Optional Kimi K3 visual/video adapter. It uses OpenAI-compatible Chat
# Completions. Video is sent only after local audio-track removal; otherwise
# the adapter uses extracted frames and does not claim audio/ASR support.
KIMI_API_KEY=
KIMI_MULTIMODAL_MODEL=kimi-k3
# Use the official provider endpoint or your own trusted gateway.
# KIMI_API_BASE_URL=https://api.moonshot.cn/v1
# KIMI_API_ALLOWED_HOSTS=another-trusted-gateway.example.com
# KIMI_REASONING_EFFORT=max
# KIMI_REQUEST_MAX_BYTES=18874368

# Optional Volcengine Ark Seed 2.1 Pro visual-detail scout. The UI may provide
# a memory-only key; server-side keys must never use a VITE_ prefix.
SEED_API_KEY=
# Also accepts Volcengine's official ARK_API_KEY name when SEED_API_KEY is empty.
# ARK_API_KEY=
SEED_MULTIMODAL_MODEL=doubao-seed-2-1-pro-260628
SEED_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Complete-video visual sampling rate; accepted range is 0.2-5 fps.
SEED_VIDEO_FPS=2
# Optional request-model override for an Ark inference endpoint. Leave unset
# when using the official model ID above.
# SEED_INFERENCE_ENDPOINT_ID=ep-m-xxxxxxxxxxxxxxxx-xxxxx
# SEED_API_ALLOWED_HOSTS=another-trusted-ark-host.example.com
# SEED_REQUEST_MAX_BYTES=50331648
# SEED_TIMEOUT_MS=300000

# Server default remains Gemini. Supported fixed profiles are gemini,
# kimi-k3, seed-2.1-pro and fusion. The UI may override the profile for the
# current tab without allowing arbitrary model IDs or upstream URLs.
MULTIMODAL_DEFAULT_PROFILE=gemini

# Required downstream text/search model. Multimodal providers only run MM01;
# C01 must use a search-capable model, then P02 uses the configured text model.
# Select one server-owned protocol. Browser requests may override only the key,
# never this protocol, endpoint, auth mode or model IDs.
DOWNSTREAM_MODEL_PROTOCOL=openai-responses
DOWNSTREAM_MODEL_API_KEY=
DOWNSTREAM_MODEL_API_BASE_URL=https://api.openai.com/v1
# openai-responses always uses bearer. For gemini-native, official Google uses
# google-api-key while compatible gateways may use bearer.
DOWNSTREAM_MODEL_AUTH_MODE=bearer
DOWNSTREAM_TEXT_MODEL=gpt-5-mini
C01_SEARCH_MODEL=gpt-5-mini
P02_TEXT_MODEL=gpt-5-mini
C01_SEARCH_TOOL=web_search_preview
# DOWNSTREAM_MODEL_TIMEOUT_MS=180000

# Gemini-native alternative (C01 uses google_search; P02 does not search):
# DOWNSTREAM_MODEL_PROTOCOL=gemini-native
# DOWNSTREAM_MODEL_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# DOWNSTREAM_MODEL_AUTH_MODE=bearer
# DOWNSTREAM_TEXT_MODEL=gemini-3.1-pro-preview-thinking
# C01_SEARCH_MODEL=gemini-3.1-pro-preview-thinking
# P02_TEXT_MODEL=gemini-3.1-pro-preview-thinking
# C01_SEARCH_TOOL is ignored by gemini-native; google_search is fixed server-side.

# Required on deployed environments. The shared Beta access code is server-only.
MULTIMODAL_ACCESS_TOKEN=
# MULTIMODAL_MAX_CONCURRENT=2
# MULTIMODAL_RATE_LIMIT_PER_MINUTE=12
# PROVIDER_MAX_CONCURRENT=4
# PROVIDER_RATE_LIMIT_PER_MINUTE=30

# Whole-video inline is preferred. Oversized video is transcoded, then falls
# back to timestamped keyframes plus extracted audio when necessary.
# GEMINI_INLINE_VIDEO_MAX_BYTES=10485760
# GEMINI_TRANSCODE_TARGET_BYTES=8388608
# MULTIMODAL_DOWNLOAD_MAX_BYTES=67108864
# Local Clash Verge Fake-IP compatibility only. Keep false in deployments.
# MULTIMODAL_ALLOW_CLASH_FAKE_IP=false
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe

# Local durable artifact archive. Every source keeps its original media once,
# while each re-analysis creates a new immutable run. This path must be backed
# by durable storage in deployments; a serverless temporary filesystem is not durable.
PORTFOLIO_PROJECT_ID=default
# PORTFOLIO_ARTIFACT_ROOT=./.portfolio-data
# PORTFOLIO_ARTIFACTS_ENABLED=true
